{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.com/schemas/osis-record.schema.json",
  "title": "OSIS Record",
  "type": "object",
  "required": [
    "record_id",
    "title",
    "document_type",
    "version",
    "status",
    "created_by",
    "created_at",
    "owner",
    "classification",
    "source_hash",
    "audit_log_reference",
    "storage_location"
  ],
  "properties": {
    "record_id": { "type": "string", "description": "Unique identifier for the record." },
    "title": { "type": "string" },
    "document_type": { "type": "string", "enum": ["document", "email", "approval", "signature", "policy", "report", "attachment", "metadata", "request"] },
    "version": { "type": "string" },
    "status": { "type": "string", "enum": ["draft", "review", "approved", "signed", "archived", "rejected", "legal_hold"] },
    "created_by": { "type": "string" },
    "created_at": { "type": "string", "format": "date-time" },
    "updated_by": { "type": ["string", "null"] },
    "updated_at": { "type": ["string", "null"], "format": "date-time" },
    "owner": { "type": "string" },
    "classification": { "type": "string" },
    "privacy_sensitivity": { "type": ["string", "null"] },
    "retention_category": { "type": ["string", "null"] },
    "related_document_ids": { "type": "array", "items": { "type": "string" } },
    "related_email_ids": { "type": "array", "items": { "type": "string" } },
    "approval_status": { "type": ["string", "null"] },
    "signature_status": { "type": ["string", "null"] },
    "signer_name": { "type": ["string", "null"] },
    "signer_role": { "type": ["string", "null"] },
    "identity_verification_method": { "type": ["string", "null"] },
    "signed_at": { "type": ["string", "null"], "format": "date-time" },
    "source_hash": { "type": "string", "description": "SHA-256 hash of the source artifact or signed content." },
    "previous_hash": { "type": ["string", "null"] },
    "audit_log_reference": { "type": "string" },
    "storage_location": { "type": "string", "description": "Storage URI or path for the record artifact." },
    "access_controls": { "type": ["array", "null"], "items": { "type": "string" } },
    "legal_hold": { "type": "boolean", "default": false },
    "decision": { "type": ["string", "null"], "enum": ["Go", "No-go", "Pilot only", null] },
    "decision_rationale": { "type": ["string", "null"] },
    "release_identifier": { "type": ["string", "null"] },
    "evidence_links": { "type": ["array", "null"], "items": { "type": "string" } },
    "open_exceptions": { "type": ["array", "null"], "items": { "type": "string" } },
    "rollback_trigger": { "type": ["string", "null"] },
    "next_review_date": { "type": ["string", "null"], "format": "date-time" },
    "approvers": {
      "type": ["array", "null"],
      "items": {
        "type": "object",
        "required": ["signer_name", "signer_role", "approval_status"],
        "properties": {
          "signer_name": { "type": "string" },
          "signer_role": { "type": "string" },
          "approval_status": { "type": "string" },
          "identity_verification_method": { "type": ["string", "null"] },
          "signed_at": { "type": ["string", "null"], "format": "date-time" },
          "comments": { "type": ["string", "null"] }
        },
        "additionalProperties": true
      }
    },
    "governance_evidence": {
      "type": ["object", "null"],
      "description": "Links Indigenous/community governance evidence with applicable Canadian constitutional, federal, provincial, treaty, and rights-based review. It records issues for review and does not itself determine legal authority.",
      "properties": {
        "indigenous_governance": {
          "type": ["object", "null"],
          "properties": {
            "community": { "type": ["string", "null"] },
            "authority": { "type": ["string", "null"] },
            "instrument": { "type": ["string", "null"], "enum": ["bylaw", "resolution", "policy", "custom_code", "procedure", "other", null] },
            "community_values": { "type": ["array", "null"], "items": { "type": "string" } },
            "elders_or_knowledge_holders": { "type": ["array", "null"], "items": { "type": "string" } },
            "community_consultation": { "type": ["array", "null"], "items": { "type": "string" } },
            "evidence_links": { "type": ["array", "null"], "items": { "type": "string" } }
          },
          "additionalProperties": true
        },
        "canadian_legal": {
          "type": ["object", "null"],
          "properties": {
            "constitutional_framework": { "type": ["array", "null"], "items": { "type": "string" } },
            "section_35_review": { "type": ["string", "null"], "enum": ["required", "completed", "not_applicable", "pending", null] },
            "federal_legislation": { "type": ["array", "null"], "items": { "type": "string" } },
            "provincial_legislation": { "type": ["array", "null"], "items": { "type": "string" } },
            "treaty_or_agreement": { "type": ["array", "null"], "items": { "type": "string" } },
            "court_authority": { "type": ["array", "null"], "items": { "type": "string" } },
            "reviewer": { "type": ["string", "null"] },
            "evidence_links": { "type": ["array", "null"], "items": { "type": "string" } }
          },
          "additionalProperties": true
        },
        "compatibility": {
          "type": ["object", "null"],
          "properties": {
            "jurisdiction_verified": { "type": "boolean" },
            "authority_verified": { "type": "boolean" },
            "rights_reviewed": { "type": "boolean" },
            "conflict_identified": { "type": "boolean" },
            "conflict_description": { "type": ["string", "null"] },
            "legal_review": { "type": "string", "enum": ["pending", "in_review", "complete", "not_applicable"] },
            "community_review": { "type": "string", "enum": ["pending", "in_review", "complete", "not_applicable"] },
            "resolution_record_ids": { "type": ["array", "null"], "items": { "type": "string" } }
          },
          "additionalProperties": true
        },
        "decision_chain": {
          "type": ["array", "null"],
          "items": { "type": "string", "enum": ["authority", "indigenous_governance_evidence", "canadian_legal_evidence", "rights_analysis", "consultation", "decision", "verification", "implementation", "audit", "review"] }
        }
      },
      "additionalProperties": true
    }
  },
  "additionalProperties": true
}
