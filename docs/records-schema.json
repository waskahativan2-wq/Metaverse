{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.com/schemas/osis-record.schema.json",
  "title": "OSIS Record",
  "type": "object",
  "required": ["record_id", "title", "document_type", "version", "status", "created_by", "created_at", "owner", "classification", "source_hash", "audit_log_reference", "storage_location"],
  "properties": {
    "record_id": { "type": "string" },
    "title": { "type": "string" },
    "document_type": { "type": "string", "enum": ["document", "email", "approval", "signature", "policy", "report", "attachment", "metadata", "request", "security_evidence", "safety_moderation", "ai_mixed_reality_evidence", "reliability_evidence", "release_authorization", "trust_evidence"] },
    "version": { "type": "string" },
    "status": { "type": "string", "enum": ["draft", "review", "verification", "approved", "signed", "archived", "rejected", "legal_hold"] },
    "created_by": { "type": "string" },
    "created_at": { "type": "string", "format": "date-time" },
    "updated_by": { "type": ["string", "null"] },
    "updated_at": { "type": ["string", "null"], "format": "date-time" },
    "owner": { "type": "string" },
    "classification": { "type": "string" },
    "privacy_sensitivity": { "type": ["string", "null"] },
    "retention_category": { "type": ["string", "null"] },
    "related_document_ids": { "type": "array", "items": { "type": "string" } },
    "related_email_ids": { "type": "array", "items": { "type": "string" } },
    "approval_status": { "type": ["string", "null"] },
    "signature_status": { "type": ["string", "null"] },
    "signer_name": { "type": ["string", "null"] },
    "signer_role": { "type": ["string", "null"] },
    "identity_verification_method": { "type": ["string", "null"] },
    "signed_at": { "type": ["string", "null"], "format": "date-time" },
    "source_hash": { "type": "string" },
    "previous_hash": { "type": ["string", "null"] },
    "audit_log_reference": { "type": "string" },
    "storage_location": { "type": "string" },
    "access_controls": { "type": ["array", "null"], "items": { "type": "string" } },
    "legal_hold": { "type": "boolean", "default": false },
    "decision": { "type": ["string", "null"], "enum": ["Go", "No-go", "Pilot only", null] },
    "decision_rationale": { "type": ["string", "null"] },
    "release_identifier": { "type": ["string", "null"] },
    "evidence_links": { "type": ["array", "null"], "items": { "type": "string" } },
    "open_exceptions": { "type": ["array", "null"], "items": { "type": "string" } },
    "rollback_trigger": { "type": ["string", "null"] },
    "next_review_date": { "type": ["string", "null"], "format": "date-time" },
    "approvers": { "type": ["array", "null"], "items": { "type": "object", "required": ["signer_name", "signer_role", "approval_status"], "properties": { "signer_name": { "type": "string" }, "signer_role": { "type": "string" }, "approval_status": { "type": "string" }, "identity_verification_method": { "type": ["string", "null"] }, "signed_at": { "type": ["string", "null"], "format": "date-time" }, "comments": { "type": ["string", "null"] } }, "additionalProperties": true } },
    "governance_evidence": { "type": ["object", "null"], "additionalProperties": true },
    "security_evidence": { "type": ["object", "null"], "additionalProperties": true },
    "safety_moderation": { "type": ["object", "null"], "additionalProperties": true },
    "mr_ai_evidence": { "type": ["object", "null"], "additionalProperties": true },
    "reliability_evidence": { "type": ["object", "null"], "additionalProperties": true },
    "launch_evidence": {
      "type": ["object", "null"],
      "properties": {
        "release": { "type": ["object", "null"], "additionalProperties": true },
        "evidence": { "type": ["object", "null"], "additionalProperties": true },
        "gates": { "type": ["object", "null"], "additionalProperties": true },
        "approval": { "type": ["object", "null"], "additionalProperties": true },
        "integrity": { "type": ["object", "null"], "additionalProperties": true },
        "launch_readiness": { "type": "string", "enum": ["PENDING", "GO", "NO-GO", "PILOT_ONLY"] }
      },
      "additionalProperties": true
    },
    "integrity_signature": {
      "type": ["object", "null"],
      "description": "Final trust layer connecting canonical records, hashes, signatures, identity, authority, audit, and launch decisions. Cryptographic verification does not itself establish governance authority.",
      "properties": {
        "subject": {
          "type": "object",
          "required": ["record_id", "document_version"],
          "properties": {
            "record_id": { "type": "string" },
            "document_version": { "type": "string" },
            "release_identifier": { "type": ["string", "null"] }
          },
          "additionalProperties": true
        },
        "integrity": {
          "type": "object",
          "required": ["canonicalization", "hash_algorithm", "source_hash"],
          "properties": {
            "canonicalization": { "type": "string" },
            "hash_algorithm": { "type": "string", "const": "SHA-256" },
            "source_hash": { "type": "string", "pattern": "^sha256:[A-Fa-f0-9]+$" },
            "hash_created_at": { "type": ["string", "null"], "format": "date-time" },
            "previous_hash": { "type": ["string", "null"] },
            "chain_position": { "type": ["integer", "null"], "minimum": 0 }
          },
          "additionalProperties": true
        },
        "signature": {
          "type": "object",
          "required": ["signature_status"],
          "properties": {
            "signature_status": { "type": "string", "enum": ["UNSIGNED", "SIGNED", "REVOKED", "INVALID"] },
            "signer_name": { "type": ["string", "null"] },
            "signer_role": { "type": ["string", "null"] },
            "identity_verification_method": { "type": ["string", "null"] },
            "certificate_reference": { "type": ["string", "null"] },
            "public_key_reference": { "type": ["string", "null"] },
            "signature_algorithm": { "type": ["string", "null"] },
            "signature_value_reference": { "type": ["string", "null"] },
            "signed_at": { "type": ["string", "null"], "format": "date-time" }
          },
          "additionalProperties": true
        },
        "verification": {
          "type": "object",
          "properties": {
            "hash_verified": { "type": "boolean" },
            "signature_verified": { "type": "boolean" },
            "signer_authority_verified": { "type": "boolean" },
            "document_unchanged": { "type": "boolean" },
            "verification_method": { "type": ["string", "null"] },
            "verified_at": { "type": ["string", "null"], "format": "date-time" },
            "verified_by": { "type": ["string", "null"] }
          },
          "additionalProperties": true
        },
        "audit": {
          "type": "object",
          "properties": {
            "audit_log_reference": { "type": "string" },
            "storage_location": { "type": "string" },
            "access_log_reference": { "type": ["string", "null"] }
          },
          "additionalProperties": true
        },
        "decision": {
          "type": "object",
          "properties": {
            "integrity_status": { "type": "string", "enum": ["PENDING", "VERIFIED", "FAILED"] },
            "signature_status": { "type": "string", "enum": ["PENDING", "VERIFIED", "FAILED"] },
            "authorization_status": { "type": "string", "enum": ["NOT_AUTHORIZED", "AUTHORIZED", "REVOKED"] }
          },
          "additionalProperties": true
        }
      },
      "additionalProperties": true
    }
  },
  "additionalProperties": true
}
