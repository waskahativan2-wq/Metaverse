{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.com/schemas/osis-record.schema.json",
  "title": "OSIS Record",
  "type": "object",
  "required": [
    "record_id",
    "title",
    "document_type",
    "version",
    "status",
    "created_by",
    "created_at",
    "owner",
    "classification",
    "source_hash",
    "audit_log_reference",
    "storage_location"
  ],
  "properties": {
    "record_id": {
      "type": "string",
      "description": "Unique identifier for the record."
    },
    "title": {
      "type": "string"
    },
    "document_type": {
      "type": "string",
      "enum": [
        "document",
        "email",
        "approval",
        "signature",
        "policy",
        "report",
        "attachment",
        "metadata",
        "request"
      ]
    },
    "version": {
      "type": "string"
    },
    "status": {
      "type": "string",
      "enum": [
        "draft",
        "review",
        "approved",
        "signed",
        "archived",
        "rejected",
        "legal_hold"
      ]
    },
    "created_by": {
      "type": "string"
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    },
    "updated_by": {
      "type": ["string", "null"]
    },
    "updated_at": {
      "type": ["string", "null"],
      "format": "date-time"
    },
    "owner": {
      "type": "string"
    },
    "classification": {
      "type": "string"
    },
    "privacy_sensitivity": {
      "type": ["string", "null"]
    },
    "retention_category": {
      "type": ["string", "null"]
    },
    "related_document_ids": {
      "type": "array",
      "items": { "type": "string" }
    },
    "related_email_ids": {
      "type": "array",
      "items": { "type": "string" }
    },
    "approval_status": {
      "type": ["string", "null"]
    },
    "signature_status": {
      "type": ["string", "null"]
    },
    "signer_name": {
      "type": ["string", "null"]
    },
    "signer_role": {
      "type": ["string", "null"]
    },
    "identity_verification_method": {
      "type": ["string", "null"]
    },
    "signed_at": {
      "type": ["string", "null"],
      "format": "date-time"
    },
    "source_hash": {
      "type": "string",
      "description": "SHA-256 hash of the source artifact or signed content."
    },
    "previous_hash": {
      "type": ["string", "null"]
    },
    "audit_log_reference": {
      "type": "string"
    },
    "storage_location": {
      "type": "string",
      "description": "Storage URI or path for the record artifact."
    },
    "access_controls": {
      "type": ["array", "null"],
      "items": { "type": "string" }
    },
    "legal_hold": {
      "type": "boolean",
      "default": false
    }
  },
  "additionalProperties": true
}
